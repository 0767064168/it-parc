{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/api"
    },
    {
      "source": "/ticket",
      "destination": "/api"
    },
    {
      "source": "/qr-ticket",
      "destination": "/api"
    },
    {
      "source": "/qr_ticket.png",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|uploads/|ticket|qr-ticket|qr_ticket\\.png).*\\.(?:js|css|png|jpg|jpeg|gif|ico|svg|wasm|json|webmanifest|ttf|otf|frag))",
      "destination": "/public/$1"
    },
    {
      "source": "/((?!api/|uploads/|ticket|qr-ticket|qr_ticket\\.png).*)",
      "destination": "/public/index.html"
    }
  ]
}
