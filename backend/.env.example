# ============================================
# Gestionnaire de Parc IT — Configuration Backend
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Supabase (PostgreSQL) ---
# Récupérez l'URL dans Supabase > Project Settings > Database > Connection string.
SUPABASE_DB_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@db.VOTRE_PROJECT_REF.supabase.co:5432/postgres
# Mettre à false uniquement pour un PostgreSQL local sans TLS.
DB_SSL=true
DB_POOL_SIZE=10
# Facultatif: URL MySQL source pour copier les données existantes.
# MYSQL_SOURCE_URL=mysql://utilisateur:mot_de_passe@hote:3306/gestionnaire_parc_it

# --- JWT Authentication ---
JWT_SECRET=votre_secret_jwt_tres_long_et_securise_minimum_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS (adresses autorisées, séparées par virgule) ---
# En dev local, inclure localhost + adresse IP du serveur
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://169.254.55.224:3000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Upload (Import Excel) ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# --- Logs ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- SMTP / E-mail Notifications ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=votre_utilisateur
SMTP_PASS=votre_mot_de_passe
SMTP_FROM="Gestionnaire Parc IT <noreply@entreprise.ci>"
EMAIL_NOTIFICATIONS_ENABLED=true
