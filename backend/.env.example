# ============================================
# Gestionnaire de Parc IT — Configuration Backend (100% Supabase)
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Base de données Supabase (PostgreSQL) ---
# Récupérez l'URI dans Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Note: encodage URL obligatoire si le mot de passe contient des caractères spéciaux (?#%@...)
SUPABASE_DB_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@db.VOTRE_PROJECT_REF.supabase.co:5432/postgres
DB_SSL=true
DB_POOL_SIZE=10

# Optionnel : Instance locale de développement (uniquement si vous n'utilisez pas Supabase en local)
DATABASE_URL=

# Optionnel : URL source MySQL pour transférer d'anciennes données avec `npm run migrate:data`
MYSQL_SOURCE_URL=

# --- JWT Authentication ---
JWT_SECRET=votre_secret_jwt_tres_long_et_securise_minimum_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS (adresses autorisées, séparées par virgule) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://169.254.55.224:3000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Upload (Import Excel) ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# --- Logs ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- SMTP / E-mail Notifications ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=votre_utilisateur
SMTP_PASS=votre_mot_de_passe
SMTP_FROM="Gestionnaire Parc IT <noreply@entreprise.ci>"
EMAIL_NOTIFICATIONS_ENABLED=false
